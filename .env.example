# Copy to .env.local and fill in. Never commit real values.
# Qloo hackathon API key. When empty, the presets replay labelled responses recorded from the Qloo API.
QLOO_API_KEY=
# Optional: force the recorded responses even when a key is set (fixture | unset)
QLOO_MODE=
# Optional: override the base URL (default https://hackathon.api.qloo.com)
QLOO_BASE_URL=

# LLM planner: a fallback chain. Claude (if ANTHROPIC_API_KEY), then Gemini (if GEMINI_API_KEY),
# then a deterministic scripted planner (same tools). A provider that times out, returns 5xx,
# 429/quota or another error hands the remaining turns to the next one; the UI says so.
ANTHROPIC_API_KEY=
# Google Gemini API key (free tier from https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: gemini | claude | scripted. Forces the primary provider (the other stays as fallback).
LLM_PROVIDER=
# Optional: model override for the primary provider
# (defaults: claude-haiku-4-5-20251001, gemini-3.5-flash-lite; gemini-3.8-flash was too slow live)
LLM_MODEL=
# Optional per-provider model overrides
CLAUDE_MODEL=
GEMINI_MODEL=
# Optional: per model call timeout in ms (default 8000)
LLM_CALL_TIMEOUT_MS=
# Optional: timeout for calls after acts are picked (pitch writing; default 18000)
PITCH_CALL_TIMEOUT_MS=
# Test only: <gemini|anthropic|all>:<hang|503> simulates a hung or failing provider
LLM_TEST_FAULT=
