# Copy to .env.local and fill in. Never commit real values.
# Qloo hackathon API key. When empty, the app runs in clearly labelled SAMPLE DATA mode.
QLOO_API_KEY=
# Optional: force sample fixtures even when a key is set (fixture | unset)
QLOO_MODE=
# Optional: override the base URL (default https://hackathon.api.qloo.com)
QLOO_BASE_URL=

# Claude (Anthropic API). When empty, a deterministic scripted planner runs the same tool sequence.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-haiku-4-5-20251001)
LLM_MODEL=
# Optional: set to "scripted" to force the scripted planner
LLM_PROVIDER=
