# Copy to .env.local and fill in. Never commit real values.
# Qloo hackathon API key. When empty, the presets replay labelled responses recorded from the Qloo API.
QLOO_API_KEY=
# Optional: force the recorded responses even when a key is set (fixture | unset)
QLOO_MODE=
# Optional: override the base URL (default https://hackathon.api.qloo.com)
QLOO_BASE_URL=

# LLM planner. Selection: LLM_PROVIDER if set, else Claude if ANTHROPIC_API_KEY is set,
# else Gemini if GEMINI_API_KEY is set, else a deterministic scripted planner (same tool sequence).
# Claude (Anthropic API), intended for the deployed version.
ANTHROPIC_API_KEY=
# Google Gemini API key (free tier from https://aistudio.google.com/apikey), used for testing.
# On a 429 / quota error the scripted planner finishes the run and the UI says so.
GEMINI_API_KEY=
# Optional: model override for the selected provider
# (defaults: claude-haiku-4-5-20251001, gemini-3.5-flash-lite; gemini-3.8-flash was too slow live)
LLM_MODEL=
# Optional: gemini | claude | scripted
LLM_PROVIDER=
